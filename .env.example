# =============================================================================
# GLOBAL THUNDER TRADE — ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. GTT Business Contact Email Destination
# Submissions from "SEND PROMPT TO GTT" will be routed to this address.
GTT_CONTACT_EMAIL=globalthundertrade@gmail.com

# 2. SMTP Server Configuration (Optional for Live Outbound Emails)
# If configured, GTT will receive formatted emails via SMTP.
# If left blank, submissions are securely captured and logged locally in `submissions/`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# 3. AI Concept Generation API Key (Optional)
# If provided, powers live AI concept image generation in the configurator.
# If left blank, the UI transparently notes that the backend endpoint is ready for an API key.
GEMINI_API_KEY=
IMAGEN_API_KEY=
